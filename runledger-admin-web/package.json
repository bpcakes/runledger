{
  "name": "@runledger/admin",
  "version": "0.11.0",
  "description": "Framework-neutral client and reusable React admin panel for Runledger",
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "./dist/styles.css"
  ],
  "files": [
    "dist",
    "src",
    "openapi.json",
    "LICENSE",
    "README.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./react": {
      "types": "./dist/react.d.ts",
      "import": "./dist/react.js"
    },
    "./openapi.json": "./openapi.json",
    "./styles.css": "./dist/styles.css"
  },
  "scripts": {
    "build": "npm run clean && tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "clean": "node scripts/clean.mjs",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\" \"tests/**/*.{ts,tsx}\" \"*.json\"",
    "generate": "openapi-typescript openapi.json -o src/generated/schema.ts --immutable --empty-objects-unknown",
    "generate:check": "openapi-typescript openapi.json -o src/generated/schema.ts --immutable --empty-objects-unknown --check",
    "prepack": "npm run build",
    "test": "npm run generate:check && npm run typecheck && npm run format:check && vitest run",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": ">=18.2 <20"
  },
  "devDependencies": {
    "@testing-library/react": "16.3.2",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "jsdom": "30.0.1",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "typescript": "5.9.3",
    "vitest": "4.1.10"
  },
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "openapi-fetch": "0.17.0"
  }
}
