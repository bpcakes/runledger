{
  "openapi": "3.1.0",
  "info": {
    "title": "Runledger Admin API",
    "description": "Read-only administration contract. The embedding application owns authentication and authorization.",
    "version": "v1"
  },
  "servers": [
    {
      "url": "/api/admin/runledger/v1"
    }
  ],
  "paths": {
    "/capabilities": {
      "get": {
        "tags": [
          "Runledger Admin"
        ],
        "operationId": "getAdminCapabilities",
        "responses": {
          "200": {
            "description": "Version and effective permissions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Capabilities"
                }
              }
            }
          },
          "401": {
            "description": "Admin access was not provided",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/definitions": {
      "get": {
        "tags": [
          "Runledger Admin"
        ],
        "operationId": "listAdminDefinitions",
        "parameters": [
          {
            "name": "job_type",
            "in": "query",
            "description": "Case-insensitive literal substring matched against the job type.",
            "required": false,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 50,
              "maximum": 200,
              "minimum": 1
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "format": "int64",
              "default": 0,
              "minimum": 0
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Page of registered job definitions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DefinitionsResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid query",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Admin access was not provided",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Access does not include service-wide definitions",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Admin data could not be loaded",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminErrorResponse"
                }
              }
            }
          }
        }
      }
    },
