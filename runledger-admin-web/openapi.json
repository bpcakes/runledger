  "components": {
    "schemas": {
      "AdminErrorResponse": {
        "type": "object",
        "required": [
          "error"
        ],
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorDetail"
          }
        }
      },
      "AdminScope": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "all"
                ]
              }
            }
          },
          {
            "type": "object",
            "required": [
              "organization_id",
              "kind"
            ],
            "properties": {
              "kind": {
                "type": "string",
                "enum": [
                  "organization"
                ]
              },
              "organization_id": {
                "type": "string",
                "format": "uuid"
              }
            }
          }
        ],
        "description": "Effective request scope reported by the capabilities endpoint."
      },
      "Capabilities": {
        "type": "object",
        "required": [
          "api_version",
          "scope",
          "visibility",
          "actions",
          "resources"
        ],
        "properties": {
          "actions": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "api_version": {
            "type": "string",
            "enum": [
              "v1"
            ]
          },
          "resources": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "scope": {
            "$ref": "#/components/schemas/AdminScope"
          },
          "visibility": {
            "$ref": "#/components/schemas/DataVisibility"
          }
        }
      },
      "DataVisibility": {
        "type": "string",
        "description": "Whether sensitive stored data may be returned to this request.",
        "enum": [
          "metadata_only",
          "full"
        ]
      },
      "DefinitionsResponse": {
        "type": "object",
        "required": [
          "items",
          "page"
        ],
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/JobDefinition"
            }
          },
          "page": {
            "$ref": "#/components/schemas/Page"
          }
        }
      },
      "ErrorDetail": {
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "properties": {
          "code": {
            "type": "string"
          },
          "message": {
            "type": "string"
          }
        }
      },
      "HistoryOrder": {
        "type": "string",
        "description": "Ordering for job event and log history.",
        "enum": [
          "newest_first",
          "oldest_first"
        ]
      },
      "HistoryPage": {
        "type": "object",
        "description": "Cursor information returned with event and log history.",
        "required": [
          "limit",
          "cursor",
          "next_cursor",
          "order",
          "has_more"
        ],
        "properties": {
          "cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "has_more": {
            "type": "boolean"
          },
          "limit": {
            "type": "integer",
            "format": "int64"
          },
          "next_cursor": {
            "type": [
              "string",
              "null"
            ]
          },
          "order": {
            "$ref": "#/components/schemas/HistoryOrder"
          }
        }
      },
      "Job": {
        "type": "object",
        "description": "Safe job representation used by list and detail endpoints.",
        "required": [
          "id",
          "job_type",
          "organization_id",
          "status",
          "priority",
          "run_number",
          "attempt",
          "max_attempts",
          "timeout_seconds",
          "next_run_at",
          "lease_expires_at",
          "last_heartbeat_at",
          "started_at",
          "finished_at",
          "stage",
          "progress_done",
          "progress_total",
          "progress_pct",
          "last_error_code",
          "created_at",
          "updated_at",
          "redacted_fields"
        ],
        "properties": {
          "attempt": {
            "type": "integer",
            "format": "int32"
          },
          "checkpoint": {},
          "created_at": {
            "type": "string",
            "format": "date-time"
          },
          "finished_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "id": {
            "type": "string",
            "format": "uuid"
          },
          "idempotency_key": {
            "type": "string"
          },
          "job_type": {
            "type": "string"
          },
          "last_error_code": {
            "type": [
              "string",
              "null"
            ]
          },
          "last_error_message": {
            "type": "string"
          },
          "last_heartbeat_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "lease_expires_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "max_attempts": {
            "type": "integer",
            "format": "int32"
          },
          "next_run_at": {
            "type": "string",
            "format": "date-time"
          },
          "organization_id": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "output": {},
          "payload": {},
          "priority": {
            "type": "integer",
            "format": "int32"
          },
          "progress_done": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "progress_pct": {
            "type": [
              "number",
              "null"
            ],
            "format": "double"
          },
          "progress_total": {
            "type": [
              "integer",
              "null"
            ],
            "format": "int64"
          },
          "redacted_fields": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "run_number": {
            "type": "integer",
            "format": "int32"
          },
          "stage": {
            "type": "string"
          },
          "started_at": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "status": {
            "type": "string"
          },
          "status_reason": {
            "type": "string"
          },
          "timeout_seconds": {
            "type": "integer",
            "format": "int32"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time"
          },
          "worker_id": {
            "type": "string"
          }
        }
      },
