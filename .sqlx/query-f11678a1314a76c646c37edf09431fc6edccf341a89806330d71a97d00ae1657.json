{
  "db_name": "PostgreSQL",
  "query": "\nSELECT\n    m.id,\n    m.session_id,\n    m.role AS \"role: ChatMessageRole\",\n    m.content,\n    m.metadata,\n    m.created_at\nFROM chat_messages m\nINNER JOIN chat_sessions s\n    ON s.id = m.session_id\nWHERE m.session_id = $1\n  AND s.organization_id = $2\n  AND s.user_id = $3\nORDER BY m.created_at ASC, m.id ASC\n        ",
