  "db_name": "PostgreSQL",
  "query": "SELECT\n            id,\n            job_type,\n            organization_id,\n            payload,\n            status::text AS \"status!\",\n            priority,\n            run_number,\n            attempt,\n            max_attempts,\n            timeout_seconds,\n            next_run_at,\n            lease_expires_at,\n            last_heartbeat_at,\n            worker_id,\n            started_at,\n            finished_at,\n            stage,\n            progress_done,\n            progress_total,\n            progress_pct::float8 AS progress_pct,\n            checkpoint,\n            output,\n            idempotency_key,\n            status_reason,\n            last_error_code,\n            last_error_message,\n            created_at,\n            updated_at\n         FROM job_queue\n         WHERE id = $1\n           AND ($2::uuid IS NULL OR organization_id = $2)\n         LIMIT 1",
