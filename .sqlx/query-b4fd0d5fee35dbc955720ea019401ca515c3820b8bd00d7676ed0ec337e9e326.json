  "db_name": "PostgreSQL",
  "query": "SELECT\n            o.id,\n            o.name AS \"name!\",\n            o.slug,\n            o.created_at AS \"created_at!\",\n            o.updated_at AS \"updated_at!\",\n            ob.plan_tier::text AS plan_tier,\n            ob.subscription_status::text AS subscription_status,\n            ob.billing_timezone,\n            ob.base_researched_allowance,\n            ob.account_pack_allowance,\n            ob.researched_allowance,\n            ob.swap_allowance,\n            ob.current_period_start_at,\n            ob.current_period_end_at,\n            ob.canceled_at\n         FROM organizations o\n         LEFT JOIN organization_billing ob ON ob.organization_id = o.id\n         WHERE o.id = $1\n         LIMIT 1",
