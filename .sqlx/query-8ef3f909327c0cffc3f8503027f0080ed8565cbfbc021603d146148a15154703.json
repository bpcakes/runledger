  "query": "\nSELECT\n    id,\n    organization_id,\n    user_id,\n    account_id,\n    outbound_draft_id,\n    type AS \"session_type: ChatSessionType\",\n    title,\n    created_at,\n    updated_at\nFROM chat_sessions\nWHERE organization_id = $1\n  AND user_id = $2\n  AND outbound_draft_id = $3\n  AND type = 'OUTBOUND_DRAFT'\nLIMIT 1\n        ",
