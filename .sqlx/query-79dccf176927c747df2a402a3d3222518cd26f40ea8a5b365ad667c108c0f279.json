{
  "db_name": "PostgreSQL",
  "query": "\nSELECT\n    r.id,\n    r.profile_id,\n    r.organization_id,\n    r.workflow_run_id,\n    wr.workflow_type AS \"workflow_type?\",\n    r.trigger,\n    r.status::text AS \"status!\",\n    r.requested_by_user_id,\n    r.requested_at,\n    r.started_at,\n    r.finished_at,\n    r.error_code,\n    r.error_message,\n    r.metadata AS \"metadata!: JsonValue\",\n    r.created_at,\n    r.updated_at\nFROM seller_profile_research_runs r\nLEFT JOIN workflow_runs wr ON wr.id = r.workflow_run_id\nWHERE r.profile_id = $1\nORDER BY r.created_at DESC, r.id DESC\nLIMIT $2\n        ",
