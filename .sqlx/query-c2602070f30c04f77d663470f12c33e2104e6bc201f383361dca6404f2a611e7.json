{
  "db_name": "PostgreSQL",
  "query": "\nSELECT\n    signal.id,\n    signal.organization_id,\n    signal.account_id,\n    signal.data_type AS \"data_type: AccountResearchChunkDataType\",\n    signal.topic_tags AS \"topic_tags!: Vec<String>\",\n    signal.source_type AS \"source_type: AccountResearchChunkSourceType\",\n    signal.source_reference,\n    signal.chunk_topic,\n    signal.confidence,\n    signal.content AS \"content!: JsonValue\",\n    signal.version,\n    signal.superseded_by,\n    signal.input_chunk_ids AS \"input_chunk_ids?: Vec<Uuid>\",\n    signal.prompt_id,\n    signal.prompt_version,\n    signal.retrieval_query AS \"retrieval_query: JsonValue\",\n    signal.model_id,\n    signal.generated_at,\n    signal.created_at,\n    signal.updated_at\nFROM account_signal_feed_items feed\nINNER JOIN account_research_chunks signal\n    ON signal.id = feed.signal_chunk_id\n   AND signal.superseded_by IS NULL\nWHERE feed.organization_id = $1\n  AND feed.account_id = $2\n  AND feed.is_classified = TRUE\n  AND ($3::text IS NULL OR feed.display_bucket = $3)\n  AND ($4::text IS NULL OR feed.signal_type = $4)\nORDER BY\n  feed.published_at_date DESC NULLS LAST,\n  feed.created_at DESC,\n  feed.signal_chunk_id DESC\nLIMIT $5\nOFFSET $6\n        ",
