{
  "db_name": "PostgreSQL",
  "query": "SELECT\n            pv.id,\n            pv.prompt_id,\n            pv.version,\n            pv.stage::text AS \"stage!\",\n            pv.content AS \"content!\",\n            pv.metadata,\n            pv.created_by,\n            u.email AS created_by_email,\n            pv.created_at AS \"created_at!\"\n         FROM prompt_versions pv\n         LEFT JOIN users u ON u.id = pv.created_by\n         WHERE pv.prompt_id = $1\n           AND pv.id = $2\n         LIMIT 1",
