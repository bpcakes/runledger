{
  "db_name": "PostgreSQL",
  "query": "\nSELECT\n    id,\n    organization_id,\n    account_id,\n    data_type AS \"data_type: AccountResearchChunkDataType\",\n    topic_tags AS \"topic_tags!: Vec<String>\",\n    source_type AS \"source_type: AccountResearchChunkSourceType\",\n    source_reference,\n    chunk_topic,\n    confidence,\n    content AS \"content!: JsonValue\",\n    version,\n    superseded_by,\n    input_chunk_ids AS \"input_chunk_ids?: Vec<Uuid>\",\n    prompt_id,\n    prompt_version,\n    retrieval_query AS \"retrieval_query: JsonValue\",\n    model_id,\n    generated_at,\n    created_at,\n    updated_at\nFROM account_research_chunks\nWHERE organization_id = $1\n  AND account_id = $2\n  AND data_type = 'PERSON'::account_research_chunk_data_type\n  AND superseded_by IS NULL\n  AND (\n        content ->> 'personId' = $3::text\n        OR (\n            $4::text IS NOT NULL\n            AND (\n                lower(person_linkedin_url) = $4\n                OR lower(split_part(split_part(COALESCE(content ->> 'linkedInUrl', ''), '#', 1), '?', 1)) = $4\n                OR lower(split_part(COALESCE(source_reference, ''), '#', 1)) = $4\n            )\n        )\n      )\nORDER BY created_at DESC, id DESC\nLIMIT 1\n        ",
