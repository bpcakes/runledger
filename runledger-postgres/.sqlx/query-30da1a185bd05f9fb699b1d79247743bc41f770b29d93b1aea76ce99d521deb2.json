  "query": "\nUPDATE contacts\nSET\n    name = $4,\n    headline = $5,\n    email = $6,\n    phone = $7,\n    updated_at = now()\nWHERE organization_id = $1\n  AND account_id = $2\n  AND id = $3\nRETURNING\n    id,\n    organization_id,\n    account_id,\n    identity_kind::text AS \"identity_kind!\",\n    external_identity,\n    COALESCE(linkedin_url, '') AS \"linkedin_url!\",\n    COALESCE(linkedin_handle, '') AS \"linkedin_handle!\",\n    name,\n    headline,\n    about,\n    photo_storage_key,\n    email,\n    phone,\n    location,\n    country_code,\n    linkedin_last_checked_at,\n    created_at,\n    updated_at\n        ",
