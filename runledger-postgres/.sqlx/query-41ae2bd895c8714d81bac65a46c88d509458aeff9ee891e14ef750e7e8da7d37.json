  "db_name": "PostgreSQL",
  "query": "SELECT\n            lt.id,\n            lt.job_id,\n            lt.run_number,\n            lt.attempt,\n            lt.organization_id,\n            lt.workflow_run_id,\n            lt.level,\n            lt.target,\n            lt.message,\n            lt.phase,\n            lt.llm_provider,\n            lt.llm_context,\n            lt.llm_attempt,\n            lt.max_output_tokens,\n            lt.will_retry AS \"will_retry!\",\n            lt.model,\n            lt.stop_reason,\n            lt.error_kind,\n            lt.error_message,\n            lt.request_json,\n            lt.response_json,\n            lt.output_json,\n            lt.raw_response_json,\n            lt.output_text,\n            lt.payload,\n            lt.occurred_at\n         FROM llm_traces lt\n         WHERE lt.id = $1\n           AND ($2::uuid IS NULL OR lt.organization_id = $2)\n         LIMIT 1",
