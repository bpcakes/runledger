  "query": "INSERT INTO workflow_runs (\n            workflow_type,\n            organization_id,\n            status,\n            idempotency_key,\n            metadata,\n            started_at\n         )\n         VALUES ($1, $2, 'RUNNING', $3, $4::jsonb, now())\n         RETURNING\n            id,\n            workflow_type,\n            organization_id,\n            status::text AS \"status!\",\n            idempotency_key,\n            metadata,\n            started_at,\n            finished_at,\n            created_at,\n            updated_at",
