  "db_name": "PostgreSQL",
  "query": "SELECT id, job_type, organization_id, status::text AS \"status!\",\n                    priority, run_number, attempt, max_attempts, next_run_at, stage,\n                    progress_done, progress_total, created_at, updated_at\n                 FROM job_queue WHERE $1::uuid IS NULL AND ($2::text::job_status IS NULL OR status = $2::text::job_status)\n                   AND ($3::text IS NULL OR job_type = $3) AND (created_at, id) < ($5, $6) ORDER BY created_at DESC, id DESC LIMIT $4",
