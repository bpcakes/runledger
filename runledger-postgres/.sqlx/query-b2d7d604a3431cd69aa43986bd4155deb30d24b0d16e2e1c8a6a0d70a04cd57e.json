  "query": "SELECT\n            id,\n            name,\n            job_type,\n            organization_id,\n            payload_template,\n            cron_expr,\n            max_jitter_seconds,\n            next_fire_at\n         FROM job_schedules\n         WHERE is_active = true\n           AND next_fire_at <= $1\n         ORDER BY next_fire_at ASC\n         FOR UPDATE SKIP LOCKED\n         LIMIT $2",
