  "query": "SELECT\n            a.id AS \"id!\",\n            a.name AS \"name!\",\n            a.industry,\n            a.city,\n            a.country,\n            a.employee_count,\n            a.revenue::double precision AS \"revenue?: f64\",\n            a.linkedin_url,\n            a.website,\n            a.logo_storage_key\n         FROM organization_accounts oa\n         INNER JOIN accounts a ON a.id = oa.account_id\n         WHERE oa.organization_id = $1\n           AND oa.account_id = $2\n         LIMIT 1",
