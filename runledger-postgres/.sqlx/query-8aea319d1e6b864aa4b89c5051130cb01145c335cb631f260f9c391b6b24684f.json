{
  "db_name": "PostgreSQL",
  "query": "\nSELECT\n    d.id, d.organization_id, d.thread_id, d.user_id,\n    d.account_id, d.signal_id, d.contact_id, d.lead_id,\n    d.subject, d.body, d.status AS \"status: crate::outbound_drafts::OutboundDraftStatus\", d.metadata,\n    d.generated_at, d.last_edited_at, d.created_at, d.updated_at,\n    t.prompt_id AS \"thread_prompt_id?\",\n    (SELECT COUNT(*)::int FROM outbound_draft_versions v WHERE v.draft_id = d.id)\n        AS \"version_count!\"\nFROM outbound_drafts d\nINNER JOIN email_threads t\n    ON t.id = d.thread_id\n   AND t.organization_id = d.organization_id\n   AND t.user_id = d.user_id\nWHERE d.organization_id = $1\n  AND d.user_id = $2\n  AND d.contact_id = $3\n  AND d.signal_id = $4\n  AND d.scenario = $5\n  AND d.status != 'ARCHIVED'::outbound_draft_status\nORDER BY d.updated_at DESC, d.id DESC\n        ",
