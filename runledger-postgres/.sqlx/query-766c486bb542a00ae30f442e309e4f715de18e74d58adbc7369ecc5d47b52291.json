  "query": "SELECT\n            job_type,\n            version,\n            max_attempts,\n            default_timeout_seconds,\n            default_priority,\n            is_enabled,\n            created_at,\n            updated_at\n         FROM job_definitions\n         WHERE ($1::text IS NULL OR job_type ILIKE '%' || $1 || '%')\n         ORDER BY job_type ASC\n         LIMIT $2\n         OFFSET $3",
