{
  "db_name": "PostgreSQL",
  "query": "\nSELECT\n    card.id,\n    card.organization_id,\n    card.account_id,\n    card.data_type AS \"data_type: AccountResearchChunkDataType\",\n    card.topic_tags AS \"topic_tags!: Vec<String>\",\n    card.source_type AS \"source_type: AccountResearchChunkSourceType\",\n    card.source_reference,\n    card.chunk_topic,\n    card.confidence,\n    card.content AS \"content!: JsonValue\",\n    card.version,\n    card.superseded_by,\n    card.input_chunk_ids AS \"input_chunk_ids?: Vec<Uuid>\",\n    card.prompt_id,\n    card.prompt_version,\n    card.retrieval_query AS \"retrieval_query: JsonValue\",\n    card.model_id,\n    card.generated_at,\n    card.created_at,\n    card.updated_at\nFROM account_research_chunks card\nINNER JOIN account_research_chunks signal\n    ON signal.id = card.source_chunk_id\n   AND signal.organization_id = card.organization_id\n   AND signal.account_id = card.account_id\n   AND signal.data_type = 'SIGNAL'::account_research_chunk_data_type\n   AND signal.superseded_by IS NULL\nWHERE card.organization_id = $1\n  AND card.account_id = $2\n  AND card.data_type = 'DERIVED_OUTPUT'::account_research_chunk_data_type\n  AND card.derived_output_key = 'signalCard'\n  AND card.source_chunk_id = $3\n  AND card.superseded_by IS NULL\nLIMIT 1\n        ",
