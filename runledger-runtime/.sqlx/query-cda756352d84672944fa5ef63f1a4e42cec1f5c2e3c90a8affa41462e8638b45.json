{
  "db_name": "PostgreSQL",
  "query": "\nSELECT\n    om.organization_id,\n    om.user_id,\n    COALESCE(u.email, '') AS \"email!\",\n    u.name,\n    om.role::text AS \"role!\",\n    om.status::text AS \"status!\",\n    om.deactivated_at\nFROM organization_memberships om\nLEFT JOIN users u ON u.id = om.user_id\nWHERE om.organization_id = $1\n  AND ($3 OR om.user_id = $2)\nORDER BY lower(u.email) NULLS LAST, u.email NULLS LAST, om.created_at ASC\n        ",
