{
  "db_name": "PostgreSQL",
  "query": "\nSELECT\n    fs.id,\n    fs.profile_id,\n    fs.field_path,\n    fs.source_type AS \"source_type: SellerProfileSourceType\",\n    fs.source_confidence AS \"source_confidence: SellerProfileSourceConfidence\",\n    fs.created_by_user_id,\n    fs.metadata AS \"metadata!: JsonValue\",\n    fs.created_at,\n    fs.updated_at\nFROM organization_seller_profiles sp\nJOIN seller_profile_field_sources fs\n    ON fs.profile_id = sp.id\nWHERE sp.organization_id = $1\nORDER BY fs.field_path ASC, fs.created_at DESC, fs.id DESC\n        ",
