{
  "db_name": "PostgreSQL",
  "query": "\nSELECT\n    se.id AS \"signal_id!\",\n    se.source AS \"signal_source!\",\n    se.event_type::text AS \"signal_event_type!\",\n    se.subtype AS signal_subtype,\n    se.canonical_key AS \"signal_canonical_key!\",\n    se.headline AS \"signal_headline!\",\n    se.description AS \"signal_description!\",\n    se.occurred_at AS \"signal_occurred_at!\",\n    se.ingested_at AS \"signal_ingested_at!\",\n    se.url AS signal_url,\n    se.source_label AS signal_source_label,\n    se.relevance_score AS signal_relevance_score,\n    se.confidence AS signal_confidence,\n    se.payload AS signal_payload,\n    se.status::text AS \"signal_status!\",\n    oasl.id AS \"link_id!\",\n    oasl.relationship AS \"link_relationship!\",\n    oasl.created_at AS \"link_created_at!\"\nFROM signal_events se\nINNER JOIN organization_account_signal_links oasl\n    ON oasl.signal_id = se.id\nWHERE oasl.organization_id = $1\n  AND oasl.account_id = $2\n  AND se.status = 'ACTIVE'::signal_event_status\n  AND se.occurred_at >= $3\nORDER BY se.occurred_at DESC, se.ingested_at DESC, se.id DESC\nLIMIT $4\n        ",
