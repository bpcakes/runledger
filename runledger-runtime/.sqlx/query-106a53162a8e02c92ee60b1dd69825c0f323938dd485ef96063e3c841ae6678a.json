  "db_name": "PostgreSQL",
  "query": "\nINSERT INTO chat_messages (\n    session_id,\n    role,\n    content,\n    metadata\n)\nSELECT\n    s.id,\n    $4,\n    $5,\n    $6\nFROM chat_sessions s\nWHERE s.id = $1\n  AND s.organization_id = $2\n  AND s.user_id = $3\nRETURNING\n    id,\n    session_id,\n    role AS \"role: ChatMessageRole\",\n    content,\n    metadata,\n    created_at\n        ",
