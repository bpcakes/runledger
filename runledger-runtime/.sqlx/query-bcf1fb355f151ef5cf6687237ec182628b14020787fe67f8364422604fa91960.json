{
  "db_name": "PostgreSQL",
  "query": "SELECT\n    id,\n    workflow_type,\n    organization_id,\n    status::text AS \"status!\",\n    result_step_key,\n    started_at,\n    finished_at,\n    created_at,\n    updated_at\nFROM workflow_runs\nWHERE ($1::text IS NULL OR status = $1::text::workflow_run_status)\n  AND ($2::text IS NULL OR workflow_type ILIKE '%' || $2 || '%')\nORDER BY created_at DESC, id DESC\nLIMIT $3\nOFFSET $4\n",
