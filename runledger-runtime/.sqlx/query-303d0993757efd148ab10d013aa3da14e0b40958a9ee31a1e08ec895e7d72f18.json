{
  "db_name": "PostgreSQL",
  "query": "\nSELECT\n    c.id AS \"contact_id!\",\n    c.organization_id AS \"contact_organization_id!\",\n    c.account_id AS \"contact_account_id!\",\n    c.identity_kind::text AS \"contact_identity_kind!\",\n    c.external_identity AS contact_external_identity,\n    COALESCE(c.linkedin_url, '') AS \"contact_linkedin_url!\",\n    COALESCE(c.linkedin_handle, '') AS \"contact_linkedin_handle!\",\n    c.name AS \"contact_name!\",\n    c.headline AS contact_headline,\n    c.about AS contact_about,\n    c.photo_storage_key AS \"contact_photo_storage_key?\",\n    c.email AS contact_email,\n    c.phone AS contact_phone,\n    c.location AS contact_location,\n    c.country_code AS contact_country_code,\n    c.linkedin_last_checked_at AS contact_linkedin_last_checked_at,\n    c.created_at AS \"contact_created_at!\",\n    c.updated_at AS \"contact_updated_at!\",\n    cp.id AS \"position_id!\",\n    cp.organization_id AS \"position_organization_id!\",\n    cp.contact_id AS \"position_contact_id!\",\n    cp.company_name AS \"position_company_name!\",\n    cp.company_linkedin_url AS position_company_linkedin_url,\n    cp.title AS \"position_title!\",\n    cp.description AS position_description,\n    cp.start_date AS position_start_date,\n    cp.end_date AS position_end_date,\n    cp.is_current AS \"position_is_current!\",\n    cp.account_id AS position_account_id,\n    cp.created_at AS \"position_created_at!\",\n    cp.updated_at AS \"position_updated_at!\"\nFROM contact_positions cp\nINNER JOIN contacts c\n    ON c.organization_id = cp.organization_id\n   AND c.id = cp.contact_id\nWHERE cp.organization_id = $1\n  AND cp.account_id = $2\n  AND c.id = $3\n  AND cp.is_current = TRUE\nORDER BY cp.updated_at DESC, cp.id DESC\nLIMIT 1\n        ",
